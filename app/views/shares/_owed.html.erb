<%# Its own partial because a Turbo Stream redraws it every time somebody pays. %>
<div id="owed" class="mt-4 border-t-2 border-line pt-3">
  <% if split.fully_paid? %>
    <p class="font-medium">Everyone has paid.</p>
  <% else %>
    <p class="flex items-baseline justify-between">
      <span class="font-medium">Still owed</span>
      <span class="font-medium tabular-nums"><%= money(split.owed_cents) %></span>
    </p>
  <% end %>
</div>
