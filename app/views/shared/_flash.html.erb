<%# Always rendered, even when empty, so Turbo Streams have a target to replace.
    A stream cannot update an element that is not on the page. %>
<div id="flash">
  <% if message.present? %>
    <%# role="alert" interrupts, role="status" waits for a pause. A refused
        action is worth interrupting for; a save confirmation is not. %>
    <p role="<%= local_assigns[:alert] ? 'alert' : 'status' %>"
       class="mb-6 border-2 border-black px-4 py-3">
      <%= message %>
    </p>
  <% end %>
</div>
