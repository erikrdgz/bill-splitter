<% portrait = avatar_portrait_index(local_assigns[:person]) %>
<span class="avatar avatar--<%= avatar_tone(name) %> <%= local_assigns[:small] ? 'avatar--small' : '' %>" aria-hidden="true">
  <%= avatar_initials(name) %>
  <% unless portrait.nil? %>
    <span class="avatar-photo avatar-photo--<%= portrait %>"></span>
  <% end %>
</span>
