<%# Why a shared partial: every form in this app rejects the same way, and the
    rule that a split must add up is reported here rather than beside a single
    field — it is a fact about the whole set of rows, not about one of them. %>
<% if record&.errors&.any? %>
  <div class="mb-6 border-2 border-black p-4" role="alert">
    <h2 class="font-medium">
      <%= pluralize(record.errors.count, "problem") %> with this split
    </h2>
    <ul class="mt-2 list-disc ps-5 text-sm">
      <% record.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
