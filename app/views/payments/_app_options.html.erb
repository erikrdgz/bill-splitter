<%# The friend's side: each of these opens Venmo or Cash App ready to pay the
    organizer. A method with no real link is never offered, so there is no
    dead button to explain. %>
<div class="payment-actions">
  <% links.select(&:real?).each do |link| %>
    <%= link_to link.url, target: "_blank", rel: "noopener noreferrer", class: "payment-action" do %>
      <%= image_tag "payments/#{link.app}.svg", alt: "", class: "payment-logo payment-logo--#{link.app}" %>
      <span>Pay with <%= link.name %></span><span aria-hidden="true">↗</span>
    <% end %>
  <% end %>
</div>
