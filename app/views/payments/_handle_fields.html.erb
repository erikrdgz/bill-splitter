<%# The same three fields whether it is a saved person or the organizer
    themselves, because PaymentHandles gives both models the same columns. %>
<div>
  <%= form.label :venmo_handle, "Venmo username", class: "block text-sm font-medium" %>
  <%= form.text_field :venmo_handle,
                      placeholder: "marissa-v",
                      autocomplete: "off",
                      autocapitalize: "none",
                      class: "mt-1 w-full border-b-2 border-line bg-transparent py-1 " \
                             "focus:outline-none" %>
</div>

<div class="mt-4">
  <%= form.label :cashapp_cashtag, "Cash App $Cashtag", class: "block text-sm font-medium" %>
  <%= form.text_field :cashapp_cashtag,
                      placeholder: "marissa",
                      autocomplete: "off",
                      autocapitalize: "none",
                      class: "mt-1 w-full border-b-2 border-line bg-transparent py-1 " \
                             "focus:outline-none" %>
</div>

<div class="mt-4">
  <%= form.label :zelle_contact, "Zelle email or phone", class: "block text-sm font-medium" %>
  <%= form.text_field :zelle_contact,
                      placeholder: "marissa@example.com",
                      autocomplete: "off",
                      autocapitalize: "none",
                      class: "mt-1 w-full border-b-2 border-line bg-transparent py-1 " \
                             "focus:outline-none" %>
</div>

<p class="mt-3 text-sm text-muted">
  Leave anything blank you do not know. The @ and $ are added for you.
</p>
