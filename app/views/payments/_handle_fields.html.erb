<% { venmo_handle: ["Venmo username", "Username"], cashapp_cashtag: ["Cash App $Cashtag", "Cashtag"] }.each do |field, (label, placeholder)| %>
  <div class="handle-field">
    <%= form.label field, label %>
    <div class="line-field"><%= form.text_field field, placeholder: placeholder, autocomplete: "off", autocapitalize: "none" %></div>
  </div>
<% end %>
