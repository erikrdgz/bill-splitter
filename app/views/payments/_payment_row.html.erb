<%# One person on the share page, or on the organizer's detail page.

    The spec rules out chips, pills and badges, so paid and unpaid are told
    apart by the row itself: a paid row's amount is struck through and muted,
    and it says when it was paid instead of offering a button. Nothing here
    relies on colour alone.

    `payable` is false on the organizer's own page, where the rows are a report
    rather than something to act on. %>
<li id="<%= dom_id(participant) %>" class="participant-card payment-card">
  <div class="payment-row-head">
    <span class="payment-name <%= "text-muted" if participant.paid? %>">
      <%= render "shared/avatar", person: participant.person, name: participant.display_name, small: true %>
      <%= participant.display_name %>
    </span>

    <span class="payment-row-figures">
      <span class="font-medium tabular-nums <%= "text-muted line-through" if participant.paid? %>"
            data-row-amount>
        <%= money(participant.amount_cents) %>
      </span>
      <% if participant.paid? %>
        <span class="text-sm text-muted">Paid <%= participant.paid_at.to_date.strftime("%b %-d") %></span>
      <% elsif !payable %>
        <span class="text-sm text-muted">Unpaid</span>
      <% end %>
    </span>
  </div>

  <%# Settling up, for whoever is reading their own row on the share page. The
      handles are the organizer's: this is money going to them. Paying comes
      first and "I paid" second, because that is the order it happens in. %>
  <% if participant.payment_method == "cash" && !participant.paid? %>
    <p class="text-sm text-muted">Paying in cash</p>
  <% elsif payable && !participant.paid? && payment_profile&.any_payment_handle? %>
    <%= render "payments/app_options",
               links: payment_links_for(payment_profile,
                                        amount_cents: participant.amount_cents,
                                        note: split.title,
                                        direction: :pay, payment_method: participant.payment_method) %>
  <% end %>

  <%# A <details> confirmation instead of turbo_confirm: in-app browsers (a link
      opened from Instagram, say) silently block window.confirm and answer
      "no", which left the button doing nothing. Plain HTML works everywhere. %>
  <% if payable && !participant.paid? %>
    <details class="paid-confirm">
      <summary class="soft-button">
        <span class="paid-confirm-closed">I paid</span>
        <span class="paid-confirm-open">Not yet</span>
      </summary>
      <div class="paid-confirm-panel">
        <p class="text-sm text-muted">Mark <%= participant.display_name %> as paid? This cannot be undone here.</p>
        <%= button_to "Yes, I paid", share_payment_path(split.share_token, participant),
                      class: "primary-button" %>
      </div>
    </details>
  <% end %>
</li>
