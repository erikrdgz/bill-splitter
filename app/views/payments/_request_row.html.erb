<%# One unpaid person on the "Send requests" screen. The single action is a text
    to their phone containing a pay link to the organizer; whatever stops that
    from working is said in words instead of leaving a dead button. %>
<% text = PaymentText.new(participant: participant, split: split, payment_profile: payment_profile,
                       share_url: share_url(split.share_token)) %>
<li id="<%= dom_id(participant, :request) %>" class="request-card">
  <div class="request-person">
    <%= render "shared/avatar", person: participant.person, name: participant.display_name, small: true %>
    <span class="request-name"><%= participant.display_name %></span>
    <strong class="request-amount"><%= money(participant.amount_cents) %></strong>
  </div>

  <% case text.blocker %>
  <% when :cash %>
    <div class="cash-arrangement"><%= image_tag "payments/cash.svg", alt: "", class: "payment-logo payment-logo--cash" %>Paying in cash</div>
  <% when :no_person %>
    <%= link_to "Connect a friend", edit_split_path(split, anchor: dom_id(participant)), class: "request-connect" %>
  <% when :no_phone %>
    <p class="request-note">No phone number to text yet.</p>
    <%= render "people/payment_details", person: participant.person, participant: participant %>
  <% when :no_organizer_handle %>
    <p class="request-note">Add your <%= text.link&.name || "Venmo or Cash App" %> below to text this request.</p>
  <% else %>
    <%= link_to text.sms_url, class: "payment-action" do %>
      <%= image_tag "payments/#{text.app}.svg", alt: "", class: "payment-logo payment-logo--#{text.app}" %>
      <span>Text <%= text.link.name %> link to <%= participant.display_name.split.first %></span><span aria-hidden="true">↗</span>
    <% end %>
    <%= render "people/payment_details", person: participant.person, participant: participant %>
  <% end %>
</li>
