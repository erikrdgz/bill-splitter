<%# One person's row in the split editor: who they are, what they owe, and what
    share of the bill that is. The percentage is worked out from cents and
    shown to one decimal, per rule 5 — it is never added back up.

    dom_id gives the row a stable id (participant_42) so a Turbo Stream can
    replace or remove exactly this row.

    In custom mode the row also carries a slider and a lock. Those inputs sit
    inside this <li>, but `form:` associates them with the amounts form further
    down the page — a form cannot be nested inside the remove button's form, and
    the HTML form attribute is how a control says which form it belongs to. %>
<% field_name = ->(attribute) { "split[participants_attributes][#{participant_counter}][#{attribute}]" } %>

<li id="<%= dom_id(participant) %>"
    class="participant-card swipe-card" tabindex="0"
    aria-label="<%= participant.display_name %>. Swipe left or press Delete to remove."
    data-controller="swipe-logic" data-action="pointerdown->swipe-logic#start pointermove->swipe-logic#move pointerup->swipe-logic#finish pointercancel->swipe-logic#cancel keydown->swipe-logic#key click->swipe-logic#click:capture"
    data-split-logic-target="row">

  <%= button_to split_participant_path(split, participant), method: :delete,
                disabled: !removable, hidden: true, class: "swipe-delete",
                data: { swipe_logic_target: "delete" }, aria: { label: "Remove #{participant.display_name}" } do %>
    <%= render "shared/delete_icon" %>
  <% end %>
  <div class="participant-card-surface" data-swipe-logic-target="surface">
  <div class="participant-top">
    <%= render "participants/participant_name", participant: participant, split: split %>

    <span class="participant-figures">
      <span class="text-sm tabular-nums text-muted" data-split-logic-target="percentage">
        <%= number_with_precision(participant.percentage, precision: 1) %>%
      </span>
      <% if split.custom? %>
        <span data-controller="amount-keypad-logic" data-amount-keypad-logic-person-value="true"
          data-action="amount-keypad-logic:prepare->split-logic#prepareAmount amount-keypad-logic:apply->split-logic#setAmount">
          <input type="hidden" data-amount-keypad-logic-target="field">
          <button type="button" class="w-20 text-right font-medium tabular-nums amount-trigger"
            aria-label="Edit <%= participant.display_name %>'s amount" aria-haspopup="dialog"
            data-split-logic-target="amount" data-row-amount data-action="amount-keypad-logic#open"><%= money(participant.amount_cents) %></button>
          <%= render "shared/amount_keypad", person: true %>
        </span>
      <% else %>
        <span class="w-20 text-right font-medium tabular-nums" data-split-logic-target="amount" data-row-amount><%= money(participant.amount_cents) %></span>
      <% end %>

    </span>
  </div>

  <% if split.custom? %>
    <div class="slider-controls">
      <%= hidden_field_tag field_name.call(:id), participant.id,
                           id: nil, form: "split_amounts" %>

      <%# Normal sliders span the whole bill. An invalid lowered bill must also
          accommodate the existing shares, or the browser silently clamps them
          before the user can see and correct the true excess. All rows still
          use the same fixed range; dragging never changes another row's max. %>
      <input type="range"
             name="<%= field_name.call(:amount_cents) %>"
             form="split_amounts"
             min="0"
             max="<%= [ split.total_cents.to_i, split.participants.map(&:amount_cents).max.to_i ].max %>"
             step="1"
             value="<%= participant.amount_cents %>"
             class="w-full accent-accent"
             aria-label="<%= participant.display_name %>'s share"
             data-split-logic-target="slider"
             data-action="input->split-logic#drag keydown->split-logic#stepShare">

      <%# The hidden field is how an unchecked box still sends a value. It needs
          the form attribute too, or it would belong to the remove button's form. %>
      <%= hidden_field_tag field_name.call(:locked), "0", id: nil, form: "split_amounts" %>
      <label class="flex shrink-0 items-center gap-1 text-sm">
        <input type="checkbox"
               name="<%= field_name.call(:locked) %>"
               form="split_amounts"
               value="1"
               class="accent-accent"
               <%= "checked" if participant.locked? %>
               aria-label="Lock <%= participant.display_name %>"
               data-split-logic-target="lock"
               data-action="split-logic#toggleLock">
        <span aria-hidden="true">Lock</span>
      </label>
    </div>
  <% end %>
  </div>
</li>
