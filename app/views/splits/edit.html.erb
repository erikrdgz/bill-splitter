<% content_for :title, @split.title %>
<% content_for :page_class, "page--composer" %>
<h1 class="sr-only">Edit split</h1>
<%# Editing a saved split reopens the very same composer, already on the people
    step, so there is one UI to learn and nothing that can drift out of step. %>
<%= render "composer", split: @split, url: split_path(@split), method: :patch, people_count: @people_count,
                       draft_rows: @draft_rows, restored: true %>
