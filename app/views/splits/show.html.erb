<% content_for :title, @split.title %>
<% outstanding = @split.participants.reject(&:paid?) %>
<% paid = @split.participants.select(&:paid?) %>

<div class="screen-toolbar">
  <%= link_to splits_path, class: "icon-button", aria: { label: "All splits" } do %>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m14 6-6 6 6 6"/></svg>
  <% end %>
  <%= link_to edit_split_path(@split), class: "toolbar-action", aria: { label: "Edit split" } do %>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m15 5 4 4M4 20l4-1L20 7a2.8 2.8 0 0 0-4-4L4 15Z"/></svg>
    Edit
  <% end %>
</div>

<header class="request-heading">
  <h1><%= outstanding.empty? ? "All settled" : "Send requests" %></h1>
  <p><%= @split.title %></p>
  <div class="request-context"><span><%= money(@split.total_cents) %> total</span><span><%= pluralize(@split.participants.size, "person") %></span></div>
</header>

<% if outstanding.any? %>
  <section aria-label="Requests">
    <ol id="requests">
      <%= render partial: "payments/request_row", collection: outstanding, as: :participant, locals: { split: @split, payment_profile: @payment_profile } %>
    </ol>
  </section>

  <section class="group-request" data-controller="copy-logic">
    <button type="button" class="primary-button share-button" data-action="copy-logic#share">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 16V3m-4 4 4-4 4 4M5 12v8h14v-8"/></svg>
      Share requests
    </button>
    <p role="status" class="action-feedback" data-copy-logic-target="confirmation" data-copied-text="Message copied." hidden></p>
    <%# Revealed by CopyLogic once the share actually happened. The recap is plain
        server-rendered HTML, so Close is just a link home. %>
    <section class="shared-screen" aria-labelledby="shared-heading" data-copy-logic-target="shared" hidden>
      <%# pathLength="1" lets CSS draw each stroke with one dash value, whatever its real length. %>
      <svg class="shared-check" viewBox="0 0 52 52" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="26" cy="26" r="23" pathLength="1"/>
        <path d="m15 27 8 8 15-17" pathLength="1"/>
      </svg>
      <h2 id="shared-heading" tabindex="-1">Shared!</h2>
      <p><%= @split.title %></p>
      <dl class="shared-recap">
        <div><dt>Total</dt><dd><%= money(@split.total_cents) %></dd></div>
        <div><dt>Requested from</dt><dd><%= pluralize(outstanding.size, "person") %></dd></div>
        <div><dt>Still owed</dt><dd><%= money(@split.owed_cents) %></dd></div>
        <div><dt>You pay</dt><dd><%= money(@split.remaining_cents) %></dd></div>
      </dl>
      <ol class="shared-people">
        <% outstanding.each do |participant| %>
          <li><span><%= participant.display_name %></span><span><%= money(participant.amount_cents) %></span></li>
        <% end %>
      </ol>
      <%= link_to "Close", root_path, class: "primary-button next-button shared-close" %>
    </section>
    <details class="message-preview">
      <summary>View group message</summary>
      <textarea readonly rows="6" aria-label="Every request as one message" data-copy-logic-target="source" data-action="focus->copy-logic#selectAll"><%= payment_request_message(@split) %></textarea>
      <button type="button" class="soft-button" data-action="copy-logic#copy">Copy the message</button>
    </details>
  </section>
<% end %>

<section class="receive-settings" aria-label="Your payment details">
  <%= render "payment_profiles/payment_profile", payment_profile: @payment_profile %>
</section>

<% if paid.any? %>
  <section class="settled-section" aria-labelledby="paid-heading">
    <div class="section-heading"><h2 id="paid-heading">Paid</h2><span class="people-count"><%= paid.size %> of <%= @split.participants.size %></span></div>
    <ol id="participants">
      <%= render partial: "payments/payment_row", collection: paid, as: :participant, locals: { split: @split, payable: false, payment_profile: nil } %>
    </ol>
  </section>
<% end %>

<div class="request-balance">
  <span><%= outstanding.empty? ? "Collected" : "Still owed" %></span>
  <strong><%= money(outstanding.empty? ? @split.participants.sum(&:amount_cents) : @split.owed_cents) %></strong>
</div>
<% if @split.remaining_cents.positive? %>
  <div class="request-balance"><span>You pay</span><strong><%= money(@split.remaining_cents) %></strong></div>
<% end %>

<details class="share-link-settings" data-controller="copy-logic">
  <summary>Split link</summary>
  <div class="copy-link-row">
    <input type="text" readonly value="<%= share_url(@split.share_token) %>" aria-label="Share link" data-copy-logic-target="source" data-action="focus->copy-logic#selectAll">
    <button type="button" class="soft-button" data-action="copy-logic#copy">Copy</button>
  </div>
  <p role="status" class="action-feedback" data-copy-logic-target="confirmation" data-copied-text="Link copied." hidden></p>
</details>
