<% content_for :title, @split.title %>

<h1 class="text-2xl font-semibold tracking-tight"><%= @split.title %></h1>

<p class="mt-2 flex items-baseline justify-between text-lg">
  <span>Total</span>
  <span class="font-medium tabular-nums"><%= money(@split.total_cents) %></span>
</p>

<section class="mt-8">
  <h2 class="font-medium">Who has paid</h2>

  <%# payable: false — this page reports on the split; marking somebody paid is
      something they do on their own share link. %>
  <ol id="participants" class="mt-2">
    <%= render partial: "payments/payment_row",
               collection: @split.participants,
               as: :participant,
               locals: { split: @split, payable: false } %>
  </ol>

  <%= render "shares/owed", split: @split %>
</section>

<section class="mt-10" data-controller="copy-link-logic">
  <h2 class="font-medium">Share this split</h2>
  <p class="mt-1 text-sm text-black/70">Anyone with the link can see it and mark themselves paid.</p>

  <div class="mt-2 flex gap-2">
    <%# A real, readable, selectable input: if the clipboard is blocked, the
        link can still be copied by hand. The button is a convenience, not the
        only way out. %>
    <input type="text"
           readonly
           value="<%= share_url(@split.share_token) %>"
           aria-label="Share link"
           class="w-full border-2 border-black px-2 py-2 text-sm"
           data-copy-link-logic-target="link"
           data-action="focus->copy-link-logic#selectAll">

    <button type="button"
            class="shrink-0 border-2 border-black px-3 py-2 text-sm font-medium"
            data-action="copy-link-logic#copy">Copy</button>
  </div>

  <p class="mt-2 text-sm" role="status" data-copy-link-logic-target="confirmation" hidden>
    Link copied.
  </p>
</section>

<div class="mt-10">
  <%= link_to "Edit split", edit_split_path(@split),
              class: "block border-2 border-black px-4 py-3 text-center font-medium" %>
</div>
