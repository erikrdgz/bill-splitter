<% content_for :title, "Split a bill" %>
<% content_for :page_class, "page--composer" %>
<h1 class="sr-only">Split a bill</h1>
<%# New and edit are the same screen: one form, one set of controls. Only where it
    submits and which rows it starts with differ. %>
<%= render "composer", split: @split, url: splits_path, method: :post, people_count: @people_count,
                       draft_rows: @draft_rows, restored: (@draft_rows || []).any? %>
