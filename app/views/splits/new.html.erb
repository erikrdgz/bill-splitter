<% content_for :title, "Split a bill" %>

<h1 class="text-2xl font-semibold tracking-tight">Split a bill</h1>
<p class="mt-2 text-black/70">Enter the amount and how many people. No sign-up.</p>

<%# scope: :split rather than model: @split, because this form has no record
    behind it. The two fields are an amount in dollars and a head count, neither
    of which is a column on splits, so there is nothing for form_with to read
    values from. The server turns them into cents and participants on create. %>
<%= form_with scope: :split, url: splits_path, class: "mt-8",
              data: {
                controller: "quick-split-logic",
                quick_split_logic_minimum_people_value: @minimum_people,
                quick_split_logic_maximum_people_value: @maximum_people,
                quick_split_logic_maximum_total_cents_value: @maximum_total_cents
              } do |form| %>

  <div>
    <%= form.label :amount, "Amount", class: "block font-medium" %>
    <div class="mt-2 flex items-baseline gap-2 border-b-2 border-black focus-within:border-black">
      <span aria-hidden="true" class="text-2xl">$</span>
      <%# A text field with inputmode="decimal" rather than a number field: it
          brings up the numeric keyboard on a phone, and it lets
          QuickSplitLogic parse the digits itself instead of handing a float to
          the browser. %>
      <%= form.text_field :amount,
                          inputmode: "decimal",
                          autocomplete: "off",
                          placeholder: "0.00",
                          class: "w-full bg-transparent py-2 text-2xl tabular-nums " \
                                 "focus:outline-none",
                          data: {
                            quick_split_logic_target: "amount",
                            action: "input->quick-split-logic#recalculate"
                          } %>
    </div>
  </div>

  <div class="mt-8">
    <%= form.label :people_count, "People", class: "block font-medium" %>
    <div class="mt-2 flex items-center gap-4">
      <button type="button"
              aria-label="One fewer person"
              class="size-11 border-2 border-black text-xl leading-none
                     disabled:border-black/25 disabled:text-black/25"
              data-quick-split-logic-target="decrement"
              data-action="quick-split-logic#decrement">&minus;</button>

      <%# The stepper accepts typing as well as tapping, per the spec. Both go
          through the same clamp, so neither can produce a head count the server
          would refuse. %>
      <%= form.number_field :people_count,
                            value: @default_people,
                            min: @minimum_people,
                            max: @maximum_people,
                            step: 1,
                            inputmode: "numeric",
                            class: "w-16 border-b-2 border-black bg-transparent py-2 " \
                                   "text-center text-2xl tabular-nums focus:outline-none",
                            data: {
                              quick_split_logic_target: "peopleCount",
                              action: "input->quick-split-logic#recalculate " \
                                      "change->quick-split-logic#normalizePeopleCount"
                            } %>

      <button type="button"
              aria-label="One more person"
              class="size-11 border-2 border-black text-xl leading-none
                     disabled:border-black/25 disabled:text-black/25"
              data-quick-split-logic-target="increment"
              data-action="quick-split-logic#increment">+</button>
    </div>
  </div>

  <%# aria-live="polite" so a screen reader hears the new shares once the typing
      stops, rather than on every keystroke. QuickSplitLogic adds and removes
      only the rows that changed, so the whole list is not re-announced. %>
  <section class="mt-10" aria-live="polite">
    <h2 class="font-medium">Each person pays</h2>
    <ol class="mt-2" data-quick-split-logic-target="shares">
      <%= render partial: "share_row", collection: (1..@default_people).to_a, as: :position %>
    </ol>

    <template data-quick-split-logic-target="shareRowTemplate">
      <%= render "share_row", position: 1 %>
    </template>

    <p class="mt-3 text-sm text-black/70"
       data-quick-split-logic-target="centNote"
       hidden></p>
  </section>

  <%= form.submit "Save and add names",
                  class: "mt-10 w-full border-2 border-black bg-black px-4 py-3 " \
                         "font-medium text-white" %>
<% end %>
