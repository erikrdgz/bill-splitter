<% content_for :title, "Split a bill" %>
<% content_for :page_class, "page--composer" %>
<h1 class="sr-only">Split a bill</h1>
<%= form_with scope: :split, url: splits_path, class: "composer", data: {
  controller: "quick-split-logic", action: "submit->quick-split-logic#prepareSubmit",
  quick_split_logic_minimum_people_value: @minimum_people,
  quick_split_logic_maximum_people_value: @maximum_people,
  quick_split_logic_maximum_total_cents_value: @maximum_total_cents,
  quick_split_logic_draft_value: @draft_rows || []
} do |form| %>
  <div class="bill-panel">
    <%= render "shared/errors", record: @split %>
    <%= form.label :amount, "Amount", class: "sr-only" %>
    <div class="amount-control" data-controller="amount-keypad-logic">
    <div class="bill-amount bill-amount--draft">
      <span aria-hidden="true">$</span>
      <%= form.text_field :amount, value: @split.amount, inputmode: "decimal", autocomplete: "off",
        placeholder: "0", class: "amount-input", maxlength: 10, readonly: true, aria: { haspopup: "dialog" },
        data: { quick_split_logic_target: "amount", amount_keypad_logic_target: "field",
          action: "input->quick-split-logic#recalculate click->amount-keypad-logic#open keydown->amount-keypad-logic#openKey" } %>
    </div>
    <%= render "shared/amount_keypad" %>
    </div>
    <%= form.label :title, "What's this for?", class: "sr-only" %>
    <div class="line-field">
    <%= form.text_field :title, value: @split.title, placeholder: "What’s this for?", maxlength: 80, class: "title-input" %>
    </div>
    <% if @recent_people.any? %>
      <section class="recent-section" aria-labelledby="recent-heading">
        <h2 id="recent-heading">Recent friends</h2>
        <div class="friend-list" data-controller="friend-strip-logic" data-action="scroll->friend-strip-logic#update" tabindex="0" aria-label="Recent friends, scroll for more">
          <% @recent_people.each do |person| %>
            <button type="button" class="friend-choice" aria-label="Add <%= person.name %>"
              data-action="quick-split-logic#chooseFriend" data-person-id="<%= person.id %>"
              data-friend-name="<%= person.name %>" data-portrait-index="<%= avatar_portrait_index(person) %>"
              data-phone-number="<%= person.display_phone_number %>" data-quick-split-logic-target="friend">
              <%= render "shared/avatar", person: person, name: person.name %>
              <span class="friend-name"><%= person.name %></span>
            </button>
          <% end %>
        </div>
      </section>
    <% end %>
    <div class="connect-action">
      <button type="button" class="connect-button" data-quick-split-logic-target="add" data-action="quick-split-logic#increment">Add</button>
    </div>
  </div>
  <section class="shares-panel" aria-labelledby="shares-heading">
    <div class="section-heading">
      <h2 id="shares-heading">Each person pays</h2>
      <span class="people-count" data-quick-split-logic-target="countDisplay" aria-live="polite"><%= pluralize(@people_count, "person") %></span>
      <%= form.hidden_field :people_count, value: @people_count, data: { quick_split_logic_target: "peopleCount" } %>
    </div>
    <ol class="share-cards" data-quick-split-logic-target="shares">
      <%= render partial: "share_row", collection: (1..@people_count.clamp(0, 20)).to_a, as: :position %>
    </ol>
    <template data-quick-split-logic-target="shareRowTemplate"><%= render "share_row", position: 1 %></template>
    <div class="draft-remainder" aria-live="polite">
      <span data-quick-split-logic-target="remainingLabel">You pay</span>
      <strong data-quick-split-logic-target="remaining">—</strong>
    </div>
    <div class="draft-tools">
      <button type="button" class="text-button" data-action="quick-split-logic#splitEvenly">Split evenly</button>
      <%= form.submit "Save split", class: "text-button", data: { quick_split_logic_target: "save" } %>
    </div>
    <p class="helper" data-quick-split-logic-target="centNote" hidden></p>
    <p class="form-error" role="alert" data-quick-split-logic-target="error" hidden></p>
    <button type="submit" name="intent" value="request" class="primary-button mt-4"
      data-quick-split-logic-target="review" hidden>Review requests</button>
  </section>
  <dialog class="connection-sheet" data-quick-split-logic-target="dialog" aria-labelledby="connection-title" data-action="cancel->quick-split-logic#closeConnection keydown->quick-split-logic#connectionKey">
    <div class="sheet-content">
    <div class="sheet-heading"><h2 id="connection-title" tabindex="-1" data-sheet-focus>Connect a friend</h2><button type="button" aria-label="Close connection" data-action="quick-split-logic#closeConnection">×</button></div>
    <p class="connection-amount" data-quick-split-logic-target="connectionAmount"></p>
    <div class="contact-search" data-controller="contact-search-logic"
      data-contact-search-logic-url-value="<%= search_people_path %>"
      data-action="focusout->contact-search-logic#leave reset-contact-search->contact-search-logic#reset contact-search-logic:edit->quick-split-logic#editContact contact-search-logic:select->quick-split-logic#selectContact">
      <label for="connection_name">Name</label>
      <div class="line-field">
        <input id="connection_name" type="text" maxlength="40" autocomplete="off" placeholder="Search contacts"
          role="combobox" aria-autocomplete="list" aria-controls="contact-results" aria-expanded="false"
          data-quick-split-logic-target="connectionName" data-contact-search-logic-target="input"
          data-action="input->contact-search-logic#search keydown->contact-search-logic#key">
      </div>
      <div id="contact-results" class="contact-results" role="listbox" aria-label="Contacts" data-contact-search-logic-target="results" hidden></div>
      <p class="contact-search-status" role="status" data-contact-search-logic-target="status"></p>
    </div>
    <fieldset class="payment-choices">
      <legend>Pay with</legend>
      <% Participant::PAYMENT_METHODS.each do |value, label| %>
        <label><input type="radio" name="connection_method" value="<%= value %>" <%= 'checked' if value == 'venmo' %>
          data-quick-split-logic-target="method" data-action="quick-split-logic#changeMethod"><span><%= image_tag "payments/#{value}.svg", alt: "", class: "payment-logo payment-logo--#{value}" %><%= label %></span></label>
      <% end %>
    </fieldset>
    <div data-quick-split-logic-target="handleFields">
      <label for="connection_phone">Phone number</label>
      <p class="helper">We text them a link to pay you.</p>
      <div class="line-field"><input id="connection_phone" type="tel" autocomplete="off" placeholder="(555) 123-0101" data-quick-split-logic-target="connectionPhone"></div>
    </div>
    <p class="form-error" role="alert" data-quick-split-logic-target="connectionError" hidden></p>
    <button type="button" class="primary-button mt-6" data-action="quick-split-logic#confirmConnection">Connect</button>
    </div>
  </dialog>
<% end %>
