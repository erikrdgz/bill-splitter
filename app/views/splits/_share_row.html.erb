<li class="draft-card swipe-card" tabindex="0" data-controller="swipe-logic" data-action="pointerdown->swipe-logic#start pointermove->swipe-logic#move pointerup->swipe-logic#finish pointercancel->swipe-logic#cancel keydown->swipe-logic#key click->swipe-logic#click:capture">
  <button type="button" class="swipe-delete" hidden data-swipe-logic-target="delete" data-action="quick-split-logic#remove" aria-label="Remove Person <%= position %>"><%= render "shared/delete_icon" %></button>
  <div class="draft-card-surface" data-swipe-logic-target="surface">
  <div class="draft-card-heading">
    <button type="button" class="draft-connect" aria-haspopup="dialog" data-connected="false" data-action="quick-split-logic#openConnection">
      <span class="avatar avatar--small avatar--placeholder" data-share-row-avatar aria-hidden="true" hidden><%= position %></span>
      <span class="draft-connect-copy">
        <span data-share-row-name><%= "Person #{position}" %></span>
        <span class="draft-connect-action">
          <span class="row-connect-label" data-share-row-connection>Connect</span>
          <span class="connect-affordance" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 5v14M5 12h14" data-connect-plus/><path d="m9 6 6 6-6 6" data-connect-chevron/></svg></span>
        </span>
      </span>
    </button>
    <div data-controller="amount-keypad-logic" data-amount-keypad-logic-person-value="true" data-action="amount-keypad-logic:apply->quick-split-logic#setAmount">
      <input type="hidden" data-amount-keypad-logic-target="field" data-share-amount-field>
      <button type="button" class="preview-amount amount-trigger" data-share-row-amount data-action="amount-keypad-logic#open" aria-haspopup="dialog">—</button>
      <%= render "shared/amount_keypad", person: true %>
    </div>
  </div>
  <div class="draft-slider">
    <input type="range" min="0" max="100" value="0" step="1" aria-label="Person <%= position %>'s share" data-share-row-slider data-action="input->quick-split-logic#drag keydown->quick-split-logic#stepShare">
    <label class="percent-control"><input type="text" inputmode="decimal" value="0" aria-label="Person <%= position %>'s percentage" data-share-row-percent data-action="change->quick-split-logic#setPercentage"><span>%</span></label>
  </div>
  <% %w[id person_id name payment_method phone_number amount_cents locked].each do |field| %>
    <input type="hidden" name="split[draft_rows][][<%= field %>]" data-draft-field="<%= field %>" value="">
  <% end %>
  </div>
</li>
