<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Bill Splitter" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Bill Splitter">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Turbo 8: when a save redirects back to the page it came from, morph the
        changed nodes instead of swapping the whole body, and leave the scroll
        where it was. Without this, saving from halfway down the editor throws
        the organizer back to the top of the page.

        These are the two tags `turbo_refreshes_with` would write. It is not
        used here because it works through `provide :head`, which only shows up
        if it runs before `yield :head` — written below that line it renders
        nothing at all, silently. %>
    <%= turbo_refresh_method_tag :morph %>
    <%= turbo_refresh_scroll_tag :preserve %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="app-body antialiased">
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="app-shell">
      <header class="app-header">
        <%= link_to root_path, class: "wordmark", aria: { label: "Bill Splitter" } do %><span>$</span>plit.<% end %>
        <nav aria-label="Main navigation">
          <%= link_to "New split", root_path, class: current_page?(root_path) ? "active" : nil %>
          <%= link_to "Your splits", splits_path, class: current_page?(splits_path) ? "active" : nil %>
        </nav>
      </header>
      <main id="main" class="page <%= content_for(:page_class) %>">
        <%= render "shared/flash", message: flash[:notice] %>
        <%= yield %>
      </main>
    </div>
  </body>
</html>
