<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Bill Splitter" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Bill Splitter">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <%# Mobile-first: one readable column that fills a 375 px phone and centres
      itself on a desktop. Black and white only until the design pass lands. %>
  <body class="bg-white text-black antialiased">
    <main class="mx-auto w-full max-w-md px-4 py-10">
      <%= render "shared/flash", message: flash[:notice] %>

      <%= yield %>
    </main>
  </body>
</html>
