<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Bill Splitter" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Bill Splitter">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Turbo 8: when a save redirects back to the page it came from, morph the
        changed nodes instead of swapping the whole body, and leave the scroll
        where it was. Without this, saving from halfway down the editor throws
        the organizer back to the top of the page.

        These are the two tags `turbo_refreshes_with` would write. It is not
        used here because it works through `provide :head`, which only shows up
        if it runs before `yield :head` — written below that line it renders
        nothing at all, silently. %>
    <%= turbo_refresh_method_tag :morph %>
    <%= turbo_refresh_scroll_tag :preserve %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="app-body antialiased">
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="app-shell">
      <header class="app-header">
        <%= link_to root_path, class: "wordmark", aria: { label: "Bill Splitter" } do %><span>$</span>plit.<% end %>
        <nav aria-label="Main navigation">
          <%# Icons are decorative: the visible word already names each link. %>
          <%= link_to root_path, class: [ "nav-new", ("active" if current_page?(root_path)) ] do %>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
            New split
          <% end %>
          <%= link_to splits_path, class: ("active" if current_page?(splits_path)) do %>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8m0-5v5h5M12 7.5V12l3 2"/></svg>
            History
          <% end %>
        </nav>
      </header>
      <% if DevelopmentContacts.demo_mode? %>
        <p class="demo-note">Demo: contacts are sample data with fictional 555 numbers. Nothing is sent from this site.</p>
      <% end %>
      <main id="main" class="page <%= content_for(:page_class) %>">
        <%= render "shared/flash", message: flash[:notice] %>
        <%= yield %>
      </main>
    </div>
  </body>
</html>
