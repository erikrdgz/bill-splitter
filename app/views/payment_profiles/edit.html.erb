<turbo-frame id="payment_profile" class="block">
  <div class="mt-2 border-2 border-black p-3">
    <h3 class="font-medium">How do you get paid?</h3>

    <%= form_with model: @payment_profile, url: payment_profile_path, method: :patch, class: "mt-3" do |form| %>
      <%= render "shared/errors", record: @payment_profile %>
      <%= render "payments/handle_fields", form: form %>

      <div class="mt-4 flex gap-2">
        <%= form.submit "Save",
                        class: "flex-1 border-2 border-black bg-black px-3 py-2 " \
                               "text-sm font-medium text-white" %>
        <%= link_to "Cancel", payment_profile_path,
                    class: "flex-1 border-2 border-black px-3 py-2 text-center text-sm font-medium" %>
      </div>
    <% end %>
  </div>
</turbo-frame>
