<%# The phone number a request is texted to, in a Turbo Frame so the form can
    take its place without reloading the page.

    `participant` is optional. When it is there, saving replaces the whole
    request row rather than just this frame — a new number means a new button
    beside it, and leaving that stale would be worse than a page reload. %>
<turbo-frame id="<%= dom_id(person, :payment) %>" class="block">
  <% if person.phone_number.present? %>
    <%= link_to "Change phone number",
                edit_person_path(person, participant_id: local_assigns[:participant]&.id),
                class: "payment-details-link" %>
  <% else %>
    <%= link_to "Add phone number",
                edit_person_path(person, participant_id: local_assigns[:participant]&.id),
                class: "payment-details-link" %>
  <% end %>
</turbo-frame>
