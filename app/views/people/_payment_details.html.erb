<%# What we know about where this person can be paid, in a Turbo Frame so the
    form can take its place without reloading the page.

    `participant` is optional. When it is there, saving replaces the whole
    request row rather than just this frame — a new handle means new buttons
    beside it, and leaving those stale would be worse than a page reload. %>
<turbo-frame id="<%= dom_id(person, :payment) %>" class="block">
  <% if person.any_payment_handle? %>
    <p class="text-sm text-black/70">
      <%= PaymentLink::APPS.filter_map { |app|
            next if person.handle_for(app).blank?
            "#{PaymentLink::NAMES.fetch(app)} #{person.handle_for(app)}"
          }.to_sentence %>
    </p>
    <%= link_to "Change payment details",
                edit_person_path(person, participant_id: local_assigns[:participant]&.id),
                class: "text-sm underline underline-offset-4" %>
  <% else %>
    <%= link_to "Add payment details",
                edit_person_path(person, participant_id: local_assigns[:participant]&.id),
                class: "text-sm underline underline-offset-4" %>
  <% end %>
</turbo-frame>
