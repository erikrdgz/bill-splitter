<turbo-frame id="<%= dom_id(@person, :payment) %>" class="block">
  <div class="mt-2 border-2 border-line p-3">
    <h3 class="font-medium">Where can <%= @person.name %> be paid?</h3>

    <%= form_with model: @person, class: "mt-3" do |form| %>
      <%= render "shared/errors", record: @person %>
      <%# Carried through so the answer can redraw the request row this form was
          opened from, buttons and all. %>
      <%= hidden_field_tag :participant_id, @participant&.id %>
      <%= render "payments/handle_fields", form: form %>

      <div class="mt-4 flex gap-2">
        <%= form.submit "Save",
                        class: "flex-1 border-2 border-line bg-accent px-3 py-2 " \
                               "text-sm font-medium text-ink" %>
        <%= link_to "Cancel", person_path(@person),
                    class: "flex-1 border-2 border-line px-3 py-2 text-center text-sm font-medium" %>
      </div>
    <% end %>
  </div>
</turbo-frame>
