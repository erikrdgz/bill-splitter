<turbo-frame id="<%= dom_id(@person, :payment) %>" class="block">
  <div class="payment-editor">
    <h3 class="font-medium">Where can we text <%= @person.name %>?</h3>

    <%= form_with model: @person, class: "mt-3" do |form| %>
      <%= render "shared/errors", record: @person %>
      <%# Carried through so the answer can redraw the request row this form was
          opened from, button and all. %>
      <%= hidden_field_tag :participant_id, @participant&.id %>
      <div class="handle-field">
        <%= form.label :phone_number, "Phone number" %>
        <div class="line-field"><%= form.telephone_field :phone_number, placeholder: "(555) 123-0101", autocomplete: "off" %></div>
      </div>

      <div class="mt-4 flex gap-2">
        <%= form.submit "Save", class: "primary-button flex-1" %>
        <%= link_to "Cancel", person_path(@person), class: "soft-button flex-1" %>
      </div>
    <% end %>
  </div>
</turbo-frame>
